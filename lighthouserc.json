{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs 4175",
      "startServerReadyPattern": "dist auf",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4175/",
        "http://localhost:4175/immobilie-verkaufen",
        "http://localhost:4175/kapitalanlage-immobilien",
        "http://localhost:4175/objektreport",
        "http://localhost:4175/wissen/off-market-verstehen",
        "http://localhost:4175/kontakt"
      ],
      "settings": { "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/mobile" }
  }
}
